{
    email {$ACME_EMAIL}
    servers {
        protocols h1 h2 h3
        # Behind a proxy on the host or Docker network (compose.prod.yml), take the client's
        # address and https from its X-Forwarded-* headers. Internet clients are never trusted.
        trusted_proxies static private_ranges
    }
}

# DOMAIN is the site's name (Caddy gets its certificate and redirects http to https), or :80
# for plain http behind a proxy that terminates TLS (compose.prod.yml).
{$DOMAIN} {
    root * /srv/public
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    # CSP, X-Frame-Options, Referrer-Policy, Permissions-Policy are set by the app middleware.

    @build path /build/*
    handle @build {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed br gzip
        }
    }
    @fonts path *.woff2
    header @fonts Cache-Control "public, max-age=31536000, immutable"

    @blocked path /.env* /storage/* /vendor/* /.git/*
    respond @blocked 404

    # Login rate limiting is enforced in the app (RateLimiter).

    php_fastcgi app:9000 {
        root /var/www/html/public
        lb_try_duration 15s
        lb_try_interval 250ms
    }
    file_server
    log {
        output stdout
        format json
    }
}
